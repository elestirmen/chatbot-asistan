[Unit]
Description=Kapadokya Chatbot (Gunicorn)
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=appuser
Group=appuser
WorkingDirectory=/opt/chatbot
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/chatbot/.env
ExecStart=/opt/chatbot/venv/bin/gunicorn -w 2 -k gthread --threads 8 --timeout 0 -b 127.0.0.1:5000 app:app
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target

